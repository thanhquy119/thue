{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thue-ro-fast-tax-discovery",
  "main": "fast-tax-discovery-worker.mjs",
  "compatibility_date": "2026-07-28",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "THUE_RO_FAST_DISCOVERY_URL": "https://thue-ro.vercel.app/api/cron/fast-tax-discovery"
  }
}
