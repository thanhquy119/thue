GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
OCR_GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_OCR_FALLBACK=true
ENABLE_OCR_LAB=false

# Search Grounding only discovers official URLs; it never answers directly from Google Search.
# Keep off until tests/live-search-grounding-smoke.ts passes with the same API key/project.
# auto: use only for high-risk or deep-evidence questions when direct discovery is weak.
# always: diagnostics/live smoke only. off: safe default and emergency kill switch.
SEARCH_GROUNDING_MODE=off
SEARCH_GROUNDING_GEMINI_MODEL=gemini-2.5-pro
SEARCH_GROUNDING_MAX_RESULTS=6
# Legacy compatibility. SEARCH_GROUNDING_MODE takes precedence.
ENABLE_SEARCH_GROUNDING_FALLBACK=false

RATE_LIMIT_SALT=replace-with-a-random-secret

# Primary object storage: Cloudflare R2. Keep the bucket private.
R2_ACCOUNT_ID=cloudflare_account_id
R2_BUCKET=thue-ro-legal-prod
R2_ENDPOINT=https://cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=r2_bucket_scoped_access_key
R2_SECRET_ACCESS_KEY=r2_bucket_scoped_secret_key
LEGAL_R2_SOFT_LIMIT_BYTES=5000000000

# Read-only migration fallback. Keep this token while old objects are being read and copied to R2.
# New writes use R2 whenever all R2 variables above are configured.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
LEGAL_BLOB_ACCESS=private
LEGAL_MAX_SOURCE_BYTES=100000000
LEGAL_BLOB_SOFT_LIMIT_BYTES=750000000
LEGAL_RUN_RETENTION_DAYS=30
# Start one document per daily Cron run by default; code hard-caps this at two on the free-tier policy.
LEGAL_CRON_MAX_RUNS=1
CRON_SECRET=replace-with-a-long-random-secret
INGESTION_ADMIN_SECRET=replace-with-a-different-long-random-secret

# Web Push. VAPID keys and subscriptions use R2 first and migrate lazily from Private Blob.
WEB_PUSH_SUBJECT=https://thue-ro.vercel.app
WEB_PUSH_MAX_SUBSCRIPTIONS=1000
WEB_PUSH_MAX_DOCUMENT_AGE_DAYS=60
WEB_PUSH_RECEIPT_RETENTION_DAYS=30
WEB_PUSH_CRON_MAX_REVISIONS=2
WEB_PUSH_MAX_DELIVERIES_PER_RUN=40
